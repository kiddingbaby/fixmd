{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kiddingbaby/fixmd/main/contracts/result.schema.legacy.json",
  "title": "fixmd Result",
  "allOf": [
    {
      "$ref": "./skill-result.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "fixmd"
        },
        "schema_version": {
          "const": "fixmd/v1"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "tool",
        "schema_version",
        "data"
      ]
    }
  ]
}
